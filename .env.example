# ================================================
# Copy this file to backend/.env and fill in real values
# cp .env.example backend/.env
#
# This branch uses cloud-only services: Supabase Postgres,
# Weaviate Cloud, and Redis Cloud (e.g. Upstash). No local
# Docker services are required.
# ================================================

# ── PostgreSQL (Supabase) ────────────────────────
# From Supabase project → Settings → Database → Connection string.
# Direct connection (not pooler). SSL is enforced by the app.
POSTGRES_HOST=db.<project-ref>.supabase.co
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DATABASE=postgres

# ── Weaviate Cloud ───────────────────────────────
# From Weaviate Cloud dashboard. URL is the REST endpoint
# without scheme (https:// is added automatically). API key
# is the admin key for the cluster.
WEAVIATE_URL=<cluster-id>.<region>.gcp.weaviate.cloud
WEAVIATE_API_KEY=

# ── Redis Cloud ──────────────────────────────────
# Full connection URL. Use rediss:// for TLS (required by
# most providers — Upstash, Redis Cloud, Render).
REDIS_URL=rediss://default:<password>@<host>:<port>

# ── JWT ──────────────────────────────────────────
# Generate a strong secret key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── App ──────────────────────────────────────────
APP_ENV=production

# ── Chat / Assistant ─────────────────────────────
BOT_ENGINE=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=shope-chat

# ── Semantic search ──────────────────────────────
SEMANTIC_FGCLIP_MODEL=qihoo360/fg-clip2-base
SEMANTIC_TEXT_MODEL=BAAI/bge-small-en-v1.5
SEMANTIC_DEVICE=auto

SEMANTIC_FUSION_ALPHA=0.5
SEMANTIC_OUTLIER_RATIO_TAU=0.6
SEMANTIC_IMAGE_AGG_TOP_K=3

SEMANTIC_ANN_TOPN_IMAGE=500
SEMANTIC_ANN_TOPN_TEXT=500

SEMANTIC_CACHE_BACKEND=redis
SEMANTIC_CACHE_TTL_SEC=600
